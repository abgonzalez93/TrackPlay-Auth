{
  "type": "module",
  "name": "@trackplay/auth",
  "author": "Antonio Bueno Gonzalez",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch --clear-screen=false -r tsconfig-paths/register src/server.ts",
    "start": "node --enable-source-maps --no-warnings dist/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "barrelsby:generate": "barrelsby --config .barrelsby.json",
    "madge": "madge --circular src/"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "@trackplay/core": "^1.1.8",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "redis": "^5.8.2",
    "winston": "^3.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "barrelsby": "^2.8.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
