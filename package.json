{
  "type": "module",
  "name": "@trackplay/auth",
  "author": "Antonio Bueno Gonzalez",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch --clear-screen=false -r tsconfig-paths/register src/server.ts",
    "start": "node dist/server.js",
